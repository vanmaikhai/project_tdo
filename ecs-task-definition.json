{
  "family": "tdo-socket-app-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "tdo-backend",
      "image": "YOUR_ECR_REGISTRY/tdo-socket-app-backend:latest",
      "portMappings": [
        {
          "containerPort": 9999,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "9999"
        }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:YOUR_ACCOUNT:parameter/tdo/jwt-secret"
        },
        {
          "name": "MYSQL_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:YOUR_ACCOUNT:parameter/tdo/mysql-password"
        },
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:YOUR_ACCOUNT:parameter/tdo/mysql-root-password"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node healthcheck.js"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tdo-socket-app-backend",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
