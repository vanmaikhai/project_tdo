# Database Configuration
MYSQL_DATABASE=tdo_db
MYSQL_USER=tdo_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# Backend Configuration
MYSQLDB_USER=tdo_user
MYSQLDB_ROOT_PASSWORD=your_secure_password_here
MYSQLDB_DATABASE=tdo_db
MYSQLDB_LOCAL_PORT=3398
MYSQLDB_DOCKER_PORT=3306

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=24h

# Node Environment
NODE_ENV=production
PORT=9999
